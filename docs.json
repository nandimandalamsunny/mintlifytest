{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Revolte Documentation",
  "description": "Documentation for building, deploying, observing, and controlling applications with Revolte.",
  "logo": {
    "light": "/images/brand/revolte-logo.svg",
    "dark": "/images/brand/revolte-logo.svg"
  },
  "favicon": "/images/brand/revolte-fav-icon.svg",
  "appearance": {
    "default": "dark"
  },
  "contextual": {
    "display": "toc",
    "options": ["copy", "chatgpt", "claude", "perplexity"]
  },
  "icons": {
    "library": "lucide"
  },
  "colors": {
    "primary": "#8B5CF6",
    "light": "#A78BFA",
    "dark": "#8B5CF6"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://console.revolte.ai"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Overview",
        "groups": [
          {
            "group": "Start Here",
            "pages": ["docs/index", "docs/quick-start", "docs/key-concepts"]
          },
          {
            "group": "Troubleshooting",
            "pages": ["docs/troubleshooting/common-issues"]
          }
        ]
      },
      {
        "tab": "Platform",
        "groups": [
          {
            "group": "Platform",
            "pages": [
              {
                "group": "Build Applications",
                "expanded": false,
                "pages": [
                  "docs/build/quick-start",
                  "docs/build/review-output",
                  {
                    "group": "Workflows",
                    "expanded": false,
                    "pages": ["docs/build/cli-workflow", "docs/build/web-workflow"]
                  },
                  "docs/build/pipeline"
                ]
              },
              {
                "group": "Deploy & Release",
                "expanded": false,
                "pages": [
                  "docs/deploy/quick-start",
                  "docs/deploy/environments",
                  {
                    "group": "Configuration",
                    "expanded": false,
                    "pages": ["docs/deploy/environment-variables", "docs/deploy/preview"]
                  },
                  {
                    "group": "Deployment History",
                    "expanded": false,
                    "pages": ["docs/deploy/deployment-activity", "docs/deploy/past-deployments"]
                  }
                ]
              },
              {
                "group": "Monitor & Debug",
                "expanded": false,
                "pages": [
                  "docs/observe/quick-start",
                  "docs/observe/logs",
                  "docs/observe/metrics",
                  "docs/troubleshooting/overview"
                ]
              },
              {
                "group": "Access & Control",
                "expanded": false,
                "pages": ["docs/control/users-roles", "docs/control/services"]
              },
              {
                "group": "Platform Capabilities",
                "expanded": false,
                "pages": [
                  "docs/platform/overview",
                  "docs/platform/environments",
                  "docs/platform/preview",
                  "docs/platform/ci-cd",
                  "docs/platform/observability",
                  "docs/platform/security"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Enterprise",
        "groups": [
          {
            "group": "Enterprise Features",
            "pages": ["docs/enterprise/overview"]
          }
        ]
      },
      {
        "tab": "Integrations",
        "groups": [
          {
            "group": "Integrations",
            "pages": ["docs/integrations/overview"]
          }
        ]
      },

      {
        "tab": "Resources",
        "icon": "book-open",
        "menu": [
          {
            "item": "Changelog",
            "icon": "list-timeline",
            "description": "Latest updates and releases",
            "href": "https://mintlify.com/docs/changelog"
          },
          {
            "item": "Blog",
            "icon": "newspaper",
            "description": "Articles and tutorials",
            "href": "https://mintlify.com/blog"
          },
          {
            "item": "Careers",
            "icon": "briefcase",
            "description": "Join our growing team",
            "href": "https://mintlify.com/careers"
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/mintlify",
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify"
    }
  }
}
