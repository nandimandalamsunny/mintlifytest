{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",

  "name": "Revolte",
  "description": "Developer documentation for Revolte, an AI-native software delivery platform.",

  "logo": {
    "light": "/docs/image-v2/dark-logo.svg",
    "dark": "/docs/image-v2/light-logo.svg"
  },

  "favicon": "/images/brand/revolte-fav-icon.svg",

  "appearance": {
    "default": "dark"
  },

  "contextual": {
    "display": "toc",
    "options": ["copy", "chatgpt", "claude", "perplexity"]
  },

  "icons": {
    "library": "lucide"
  },

  "colors": {
    "primary": "#6366f1",
    "light": "#818cf8",
    "dark": "#4f46e5"
  },

  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "variables": {
    "version": "2.0.0",
    "api-url": "https://api.example.com"
  },

  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://revolte.ai/"
    },
    "links": [
      {
        "label": "Talk to Us",
        "href": "https://revolte.ai/contact"
      }
    ]
  },

  "navigation": {
    "tabs": [
      {
        "tab": "Docs",

        "groups": [
          {
            "group": "Introduction",
            "pages": ["docs/overview", "docs/quick-start"]
          },

          {
            "group": "AI Workflows",

            "pages": [
              "docs/ai-workflows/overview",
              {
                "group": "Development Workflow",
                "pages": [
                  "docs/ai-workflows/development-workflow/overview",
                  "docs/ai-workflows/development-workflow/get-started"
                ]
              },
              "docs/ai-workflows/quality-assurance",
              "docs/ai-workflows/product-strategy"
            ]
          },

          {
            "group": "Integrations",

            "pages": [
              {
                "group": "Cloud",
                "expanded": false,

                "pages": [
                  "docs/integrations/cloud/overview",

                  {
                    "group": "GCP",
                    "tag": "SOON",
                    "pages": []
                  },
                  {
                    "group": "Azure",
                    "tag": "SOON",
                    "pages": []
                  }
                ]
              },

              {
                "group": "Repository",
                "expanded": false,

                "pages": [
                  "docs/integrations/repository/overview",
                  "docs/integrations/repository/github",

                  {
                    "group": "GitLab",
                    "tag": "SOON",
                    "pages": []
                  },

                  {
                    "group": "Bitbucket",
                    "tag": "SOON",
                    "pages": []
                  }
                ]
              },

              {
                "group": "Project Management",
                "expanded": false,

                "pages": [
                  "docs/integrations/project-management/overview",
                  "docs/integrations/project-management/jira",

                  {
                    "group": "Linear",
                    "tag": "SOON",
                    "pages": []
                  },

                  {
                    "group": "Azure DevOps",
                    "tag": "SOON",
                    "pages": []
                  }
                ]
              }
            ]
          },
          {
            "group": "Deployments",
            "pages": [
              "docs/deployments/overview",
              {
                "group": "Services",
                "expanded": false,
                "pages": [
                  "docs/deployments/services/overview",
                  "docs/deployments/services/web-applications",
                  "docs/deployments/services/web-services",
                  "docs/deployments/services/cron-jobs",
                  {
                    "group": "Databases",
                    "expanded": false,
                    "pages": [
                      "docs/deployments/services/databases/overview",
                      "docs/deployments/services/databases/connect"
                    ]
                  },
                  {
                    "group": "Object Storage",
                    "expanded": false,
                    "pages": [
                      "docs/deployments/services/object-storage/overview",
                      "docs/deployments/services/object-storage/explorer",
                      "docs/deployments/services/object-storage/local-access"
                    ]
                  },
                  "docs/deployments/services/cache",
                  "docs/deployments/services/domains",
                  "docs/deployments/services/secrets"
                ]
              },
              {
                "group": "Observability",
                "expanded": false,
                "pages": [
                  "docs/deployments/observability/index",
                  "docs/deployments/observability/deployment-logs",
                  "docs/deployments/observability/application-logs",
                  "docs/deployments/observability/insights"
                ]
              },
              {
                "group": "Rollbacks",
                "expanded": false,
                "pages": ["docs/deployments/rollbacks"]
              },
              "docs/deployments/pipeline"
            ]
          },

          {
            "group": "Dashboard",
            "pages": ["docs/dashboard/overview", "docs/dashboard/dora"]
          },

          {
            "group": "YML Configurations",
            "pages": [
              "docs/yaml/overview",
              "docs/yaml/syncing",
              {
                "group": "Repo Preferences",
                "expanded": false,
                "pages": [
                  "docs/yaml/repo-preferences/app-branch-settings",
                  "docs/yaml/repo-preferences/agent-workflow",
                  "docs/yaml/repo-preferences/prebuild-workflow",
                  "docs/yaml/repo-preferences/preset-service",
                  {
                    "group": "Pipelines",
                    "pages": [
                      "docs/yaml/repo-preferences/pipelines/overview",
                      "docs/yaml/repo-preferences/pipelines/code-quality",
                      "docs/yaml/repo-preferences/pipelines/test-suite"
                    ]
                  }
                ]
              },
              {
                "group": "Environment Settings",
                "expanded": false,
                "pages": [
                  "docs/yaml/environment-settings/overview",
                  "docs/yaml/environment-settings/pre-build",
                  {
                    "group": "Deployment workflow",

                    "expanded": false,
                    "pages": [
                      "docs/yaml/environment-settings/resource-specifications/web-app",
                      "docs/yaml/environment-settings/resource-specifications/web-service",
                      "docs/yaml/environment-settings/resource-specifications/database",
                      "docs/yaml/environment-settings/resource-specifications/storage-bucket",
                      "docs/yaml/environment-settings/resource-specifications/cache",
                      "docs/yaml/environment-settings/resource-specifications/variables"
                    ]
                  }
                ]
              }
            ]
          },

          {
            "group": "Platform",

            "pages": [
              {
                "group": "CLI",
                "expanded": false,

                "pages": ["docs/cli/reference", "docs/cli/quick-start"]
              },

              "docs/pricing"
            ]
          }
        ]
      },

      {
        "tab": "Changelog",

        "groups": [
          {
            "group": "Changelog",
            "pages": ["docs/changelog/overview"]
          }
        ]
      },

      {
        "tab": "Guides",

        "groups": [
          {
            "group": "Overview",

            "pages": ["docs/guides/index"]
          },

          {
            "group": "Deployments",

            "pages": ["docs/guides/deployments/quick-start", "docs/guides/deployments/presets"]
          },

          {
            "group": "Service Configuration",

            "pages": [
              "docs/guides/deployments/web-apps",
              "docs/guides/deployments/web-services",
              "docs/guides/deployments/database",
              "docs/guides/deployments/storage",
              "docs/guides/deployments/cache",
              "docs/guides/deployments/cron"
            ]
          }
        ]
      }
    ]
  }
}
